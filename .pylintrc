[MASTER]
ignore=CVS
persistent=yes
load-plugins=
jobs=1
unsafe-load-any-extension=no

[MESSAGES CONTROL]
disable=
    too-many-branches,
    too-many-locals,
    too-many-statements,
    too-many-lines,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-nested-blocks,
    too-many-return-statements,
    missing-docstring,
    invalid-name,
    line-too-long,
    broad-exception-caught,
    broad-exception-raised,
    bare-except,
    subprocess-run-check,
    attribute-defined-outside-init,
    reimported,
    unused-import,
    unused-argument,
    unused-variable,
    unused-wildcard-import,
    wildcard-import,
    wrong-import-order,
    wrong-import-position,
    ungrouped-imports,
    possibly-unused-variable,
    f-string-without-interpolation,
    redefined-outer-name,
    redefined-builtin,
    protected-access,
    simplifiable-if-expression,
    consider-using-with,
    too-many-boolean-expressions,
    global-statement,
    global-variable-not-assigned,
    import-outside-toplevel,
    multiple-statements,
    not-callable,
    no-else-break,
    no-else-continue,
    consider-using-max-builtin,
    use-dict-literal,
    used-before-assignment,
    self-assigning-variable,
    trailing-whitespace,
    trailing-newlines,
    missing-final-newline,
    unspecified-encoding,
    multiple-imports,
    no-else-return,
    bad-indentation,
    superfluous-parens,
    consider-using-from-import,
    consider-using-generator,
    consider-iterating-dictionary,
    consider-using-sys-exit,
    unnecessary-dunder-call,
    expression-not-assigned,
    duplicate-except,
    duplicate-code,
    import-error,
    too-few-public-methods,
    raise-missing-from,
    missing-timeout,
    cell-var-from-loop,
    super-with-arguments,
    chained-comparison,
    no-member

[TYPECHECK]
ignored-modules=MetaTrader5,metatrader5

[REPORTS]
output-format=text
reports=no
score=yes
